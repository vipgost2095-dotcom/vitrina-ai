# Порт, на котором поднимается Express
PORT=3001

# Токен бота — нужен для проверки подписи Telegram.WebApp.initData
BOT_TOKEN=123456:AA...

# Каталоги для БД и файлов. ⚠️ ВАЖНО: на Railway (или любом хостинге с
# постоянным Volume) все ТРИ пути должны указывать ВНУТРЬ одного и того же
# смонтированного Volume — иначе SQLite-база сохранится, а вот загруженные
# фото и сгенерированные карточки будут стираться при КАЖДОМ передеплое
# (обычная файловая система контейнера временная, только сам Volume — нет).
# Пример для Railway с Volume, смонтированным в /data:
#   DATA_DIR=/data
#   UPLOADS_DIR=/data/uploads
#   GENERATED_DIR=/data/generated
# Локально для разработки — можно оставить как есть (относительные пути).
DATA_DIR=./data
UPLOADS_DIR=./uploads
GENERATED_DIR=./generated

# CORS — домен вашего фронтенда (Mini App)
CORS_ORIGIN=https://your-frontend-domain.example

# --- TON / оплата ---
# Кошелёк администратора, куда падают платежи (non-bounceable формат)
PAYMENT_RECEIVER_ADDRESS=UQ...ваш_адрес

# Сумма оплаты в TON (эквивалент "1 GRAM", т.к. реального токена GRAM обычно нет)
TON_PAYMENT_AMOUNT=0.5

# Сеть: mainnet | testnet
TON_NETWORK=mainnet

# API для чтения транзакций блокчейна (toncenter.com). Без ключа тоже работает,
# но с более жёстким рейт-лимитом — рекомендуется получить бесплатный ключ.
TONCENTER_API_KEY=

# --- Telegram Stars ---
# Секрет для внутреннего эндпоинта, которым бот подтверждает успешную оплату Stars
# (генерируйте любую длинную случайную строку, одинаковую здесь и в bot/.env)
INTERNAL_API_SECRET=change_me_to_random_secret

# Сколько Stars стоит одна карточка (целое число, 1 Star = минимальная единица)
STARS_PAYMENT_AMOUNT=50

# --- USDT (jetton на TON) ---
# Адрес jetton-мастер контракта USDT на TON.
# Mainnet USDT (по данным tether.to/tonscan): EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Testnet USDT нужно найти отдельно или тестировать в mainnet с небольшой суммой.
USDT_JETTON_MASTER_ADDRESS=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# USDT на TON имеет 6 знаков после запятой (в отличие от TON с 9)
USDT_DECIMALS=6
# Сумма оплаты в USDT (например 0.5)
USDT_PAYMENT_AMOUNT=0.5

# --- Обработка фото: вырезание товара с фона ---
# Провайдер вырезания товара с фона (нужен реальный ключ, чтобы фон был
# по-настоящему прозрачным — это необходимо и для шага AI-генерации фона ниже).
# stub — без реального вырезания (заглушка, товар остаётся на исходном фоне)
# removebg — https://www.remove.bg/api (получить ключ на сайте)
# picsart — https://picsart.io/api (получить ключ на сайте)
PHOTO_API_PROVIDER=stub
PHOTO_API_KEY=

# --- Обработка фото: ИИ-генерация фона под товар ---
# Три режима на выбор:
# stub        — без ИИ, просто цветной градиент-подложка (работает без единого ключа)
# openai      — точный режим: сначала PHOTO_API_PROVIDER=removebg|picsart вырезает
#               товар с прозрачным фоном, потом OpenAI дорисовывает НОВЫЙ фон
#               СТРОГО в прозрачной области — пиксели товара гарантированно не
#               меняются (прозрачность используется как точная маска). Требует
#               ОБА ключа — и PHOTO_API_KEY (remove.bg/Picsart), и OPENAI_API_KEY.
# openai_full — режим "всё в одном": один вызов OpenAI прямо на исходное фото,
#               без remove.bg/Picsart — модель сама убирает старый фон и рисует
#               новый по промпту. Нужен только OPENAI_API_KEY. Но ⚠️ без точной
#               маски нет гарантии пиксель-в-пиксель сохранности товара — для
#               соцсетей/черновиков ок, для карточки на маркетплейс надёжнее
#               режим "openai" с реальным вырезанием.
AI_BACKGROUND_PROVIDER=stub
OPENAI_API_KEY=

# --- Настройка "на максимум" (актуально на август 2026) ---
# Модель генерации изображений. По умолчанию используем текущий флагман
# gpt-image-2 (лучшее следование промпту и фотореализм на сегодня). У него
# ДРУГАЯ механика размера — он умеет генерировать сразу произвольный
# WIDTHxHEIGHT под ваш заказанный размер карточки (код сам это делает,
# см. buildImageRequestParams в photoProcessing.js), поэтому параметр
# OPENAI_IMAGE_SIZE ниже для gpt-image-2 не используется.
# ⚠️ Новым/неверифицированным аккаунтам OpenAI иногда сначала не доступен
# самый новый flagship-модель — если получите ошибку про недоступную модель,
# смените на gpt-image-1.5 (стабильный, чуть дешевле) или gpt-image-1
# (старый, но всё ещё работает — снят с поддержки будет 23 октября 2026).
OPENAI_IMAGE_MODEL=gpt-image-2
# Используется ТОЛЬКО для gpt-image-1/gpt-image-1.5 (у них фиксированный
# набор размеров, в отличие от gpt-image-2) — оставьте пустым, если не уверены.
OPENAI_IMAGE_SIZE=
# Используется ТОЛЬКО для gpt-image-1/gpt-image-1.5 — качество генерации,
# 'high' это максимум, который поддерживает API (дороже low/medium, но заметно
# лучше следует промпту и меньше артефактов).
OPENAI_IMAGE_QUALITY=high
# Промпт для режима "openai" (нужен реальный прозрачный фон) — необязательно,
# если не задать, используется промпт по умолчанию из photoProcessing.js
AI_BACKGROUND_PROMPT=
# Промпт для режима "openai_full" (работает на целом фото, без маски) —
# тоже необязательно, свой промпт по умолчанию уже зашит в photoProcessing.js
AI_BACKGROUND_PROMPT_FULL=

# --- Обработка фото: ИИ-текст карточки (название/описание/буллеты) ---
# Третья ИИ-возможность, полностью независимая от генерации фона: модель
# "смотрит" на фото товара (+ учитывает описание пользователя, если оно было)
# и пишет готовый текст для карточки маркетплейса. Необязательный бонус —
# если не настроено, приложение просто не показывает текстовый блок.
# stub   — без ИИ, текст не генерируется (по умолчанию)
# openai — реальная генерация текста через OpenAI (нужен OPENAI_API_KEY, тот
#          же ключ, что и для генерации фона выше)
AI_TEXT_PROVIDER=stub
# Модель для текста — нужна поддержка image input (мультимодальная).
# gpt-5.4 (полная, не mini) — заметно точнее и лучше пишет, чем mini-версия.
# Актуальный флагман на сегодня — gpt-5.6-sol, но это "рассуждающая" модель,
# и мы НЕ проверяли вживую, что она отвечает в том же формате через обычный
# Chat Completions API (может понадобиться другой набор параметров) — если
# хотите попробовать её, задайте OPENAI_TEXT_MODEL=gpt-5.6-sol и обязательно
# проверьте результат на паре тестовых генераций, прежде чем полагаться на неё.
OPENAI_TEXT_MODEL=gpt-5.4

# --- Лимит бесплатных генераций ---
# Сколько раз пользователь может сгенерировать карточки (с ИИ, если он
# настроен — а значит, за реальные деньги) БЕЗ оплаты, прежде чем придётся
# оплатить хотя бы один заказ. После любой оплаты счётчик сбрасывается —
# пользователь снова получает FREE_GENERATIONS_LIMIT бесплатных попыток.
FREE_GENERATIONS_LIMIT=3

# --- Реферальная программа (скидки до 10%) ---
# У каждого пользователя есть личная реферальная ссылка (её показывает бот
# в /start и приложение в блоке "Реферальная программа"). Когда приглашённый
# друг делает свою ПЕРВУЮ оплату — пригласивший получает +REFERRAL_BONUS_PERCENT
# к своей скидке на собственные покупки, не выше REFERRAL_MAX_DISCOUNT_PERCENT
# суммарно. Скидка применяется автоматически при создании любого платежа
# (TON/USDT/Stars) — см. routes/payment.js.
REFERRAL_BONUS_PERCENT=2
REFERRAL_MAX_DISCOUNT_PERCENT=10
